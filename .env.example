# Copy to .env for local use, or set these as environment variables on Render.
# Leave DATABASE_URL empty to use a local SQLite file while learning.
DATABASE_URL=
# Example for filess.io (use the host, port, user, password and name from your dashboard):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
SECRET_KEY=change-this-to-a-long-random-string
# Set to 1 on Render (https) so the login cookie is only sent over https
SESSION_COOKIE_SECURE=0
